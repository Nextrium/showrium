# Copy to .env (git-ignored). Never commit real values or paste them into chat.
# Production secrets live in Cloudflare (wrangler secret) and GitHub Actions secrets.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AI providers (any subset; see ADR-0004 in internal-docs)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides for the cost benchmark
OPENROUTER_MODELS=anthropic/claude-haiku-4.5,google/gemini-3.1-flash-lite,deepseek/deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub App (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
