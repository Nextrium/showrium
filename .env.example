# Copy to .env (git-ignored). Used only by local tools such as tools/cost-benchmark; the app itself
# runs locally from apps/web/.dev.vars (see the README). Never commit real values or paste them into chat.
# Deployed apps keep their secrets in Cloudflare (wrangler secret); the deploy key lives only in the
# GitHub "preview" and "production" environments, never on anyone's machine.

# Cloudflare: optional, for the cost benchmark's Workers AI test only. Use your OWN Cloudflare account
# and a token with only "Workers AI: Read". Never Nextrium's account or deploy key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AI providers (any subset; see ADR-0004 in internal-docs)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides for the cost benchmark
OPENROUTER_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,deepseek/deepseek-v4-flash,google/gemini-3.1-flash-lite,qwen/qwen3.7-flash
DEEPSEEK_MODEL=deepseek-flash

# GitHub App (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
