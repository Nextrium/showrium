{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The admin app (admin.showrium.com): staff only. Cloudflare Access signs people in in front of
  // the whole domain; the Worker checks Access's signed token and the person's staff role on every
  // API call. It uses the same database as the product, and offers no destructive operations.
  "name": "showrium-admin-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "workers_dev": false,
  "preview_urls": false,
  // Local development: the product's local database (shared with apps/web when both run locally).
  "d1_databases": [{ "binding": "DB", "database_name": "showrium-db", "database_id": "025234bd-f294-41ed-bcbf-af7b2a2aad1a", "migrations_dir": "../../packages/db/migrations" }],
  "vars": {
    "ADMIN_URL": "http://localhost:5175",
    "APP_URL": "http://localhost:5173"
  },
  "env": {
    "production": {
      "name": "showrium-admin",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "showrium-db", "database_id": "025234bd-f294-41ed-bcbf-af7b2a2aad1a", "migrations_dir": "../../packages/db/migrations" }],
      // ACCESS_TEAM_DOMAIN and ACCESS_AUD come from the Cloudflare Access application (not secret).
      "vars": { "ADMIN_URL": "https://admin.showrium.com", "APP_URL": "https://app.showrium.com", "ACCESS_TEAM_DOMAIN": "nextrium.cloudflareaccess.com", "ACCESS_AUD": "4d64371e028eea6629869a58cd0f634e0fc058434f5b6365067a68b317c00877" },
      "observability": { "enabled": true }
    },
    "preview": {
      "name": "showrium-admin-preview",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "showrium-db-preview", "database_id": "35a309bc-a22e-45b7-b660-cc266ba8b720", "migrations_dir": "../../packages/db/migrations" }],
      "vars": { "ADMIN_URL": "https://admin-preview.showrium.com", "APP_URL": "https://preview.showrium.com", "ACCESS_TEAM_DOMAIN": "nextrium.cloudflareaccess.com", "ACCESS_AUD": "4d64371e028eea6629869a58cd0f634e0fc058434f5b6365067a68b317c00877" },
      "observability": { "enabled": true }
    }
  }
}
